# The image builds everything it serves from source, so nothing built locally should reach it: a
# stale build/ copied in would be served as this version's downloads.
build/
**/node_modules
**/.next
.git
.claude
site/out
site/public/downloads
# Copied out of build/ and traces/ by the image's own `bun run generate`; a local copy would be stale.
site/public/demo
