# Build output: the .djson scene graph, the packed dash and the plugin binary are generated,
# never committed. See docs/decisions/0002-djson-generated-from-source.md
build/
dist/
*.simhubdash
*.djson
!docs/research/samples/*.djson
!docs/research/samples/*.djson.*

node_modules/
*.tsbuildinfo

# Plugin build output. The SimHub reference assemblies under plugin/lib/ ARE committed.
bin/
obj/
.vs/
*.user

.DS_Store
Thumbs.db

# Local settings and their secrets, never committed. bun loads a .env from wherever it runs, and the
# site's Next and Prisma read site/.env and site/.env.local, which is where DATABASE_URL and
# SURVEY_ADMIN_KEY go to try the survey locally. .dockerignore keeps them out of the image as well.
.env
.env.*

# The dash build output the plugin embeds; CI copies it in before building the plugin.
plugin/OpenDash/Resources/*.simhubdash
plugin/OpenDash/Resources/*.ledsprofile
plugin/OpenDash/Resources/fonts/
plugin/OpenDash/Resources/flag-box-glyphs.json
packages/dash/fonts/.generated/
