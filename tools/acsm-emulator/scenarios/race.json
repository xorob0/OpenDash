      {"name": "Sophie Laurent", "car": "ks_audi_r8_lms_2016", "lap": 12, "pct": 0.31, "best": 98.104},
      {"name": "James Okafor", "car": "ks_mercedes_amg_gt3", "lap": 12, "pct": 0.27, "best": 98.233},
      {"name": "Akira Tanaka", "car": "ks_nissan_gtr_gt3", "lap": 12, "pct": 0.22, "best": 98.351},
      {"name": "Elena Petrova", "car": "ks_lamborghini_huracan_gt3", "lap": 12, "pct": 0.16, "best": 98.402},
      {"name": "Tom Hughes", "car": "ks_mclaren_650_gt3", "lap": 12, "pct": 0.09, "best": 98.517},
      {"name": "Nina Berg", "car": "bmw_z4_gt3", "lap": 12, "pct": 0.03, "best": 98.640},
      // In his box for the whole race, so every scenario built on this one has a PIT chip in its table
      // before its own cars go in (#1138).
