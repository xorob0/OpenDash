{
  // Every state the 8x8 flag box draws, in a fixed order, slowly enough to watch, on a loop.
  //
  // The order is the catalogue's own priority order, highest first, so that the run doubles as a
  // check on the ranking: each state should replace the one before it cleanly, and nothing should
  // flicker between two. After the flags come the pit family, the spotter, the warnings and a gear
  // sweep, which is everything below the flags in the same order the profile ranks them.
  //
  // Two runs are comparable because the order and the timings are fixed; `loop` rewinds after the
  // sweep so the whole catalogue can be watched twice without restarting the emulator.
  //
  // See docs/design/flag-box.md for what each state should look like.
  "extends": "race.json",
  "name": "The flag box catalogue, one state at a time",
  "loop": 156,
  "variables": [
    // Nothing moves on its own: every state below is set deliberately and held until the next one.
    {"name": "SessionFlags", "value": "green", "pin": true},
    {"name": "CarLeftRight", "value": 1, "pin": true},
    {"name": "EngineWarnings", "value": 0, "pin": true},
    {"name": "OnPitRoad", "value": 0, "pin": true},
    {"name": "FuelLevel", "value": 40.0, "pin": true},
    {"name": "OilTemp", "value": 95.0, "pin": true},
    {"name": "WaterTemp", "value": 88.0, "pin": true},
    {"name": "Gear", "value": 3, "pin": true},
    {"name": "RPM", "value": 4000.0, "pin": true}
  ],
  "timeline": [
    {"at": 0, "log": "hold everything: the flag cycle and the fuel burn would move it", "driver": {"type": "flagCycle", "enabled": false}},
    {"at": 0, "driver": {"type": "fuelBurn", "enabled": false}},
    {"at": 0, "driver": {"type": "rpmSweep", "enabled": false}},
    {"at": 0, "driver": {"type": "gearFromRpm", "enabled": false}},
    {"at": 0, "driver": {"type": "pitLimiterToggle", "enabled": false}},

    // --- The flags, in priority order -------------------------------------------------------
    {"at": 4, "log": "1/15 red: the whole box red", "set": {"SessionFlags": "red"}},
    {"at": 10, "log": "2/15 disqualified: a cross, blinking", "set": {"SessionFlags": "black|disqualify"}},
    {"at": 16, "log": "3/15 black: an outline", "set": {"SessionFlags": "black"}},
    {"at": 22, "log": "4/15 black furled: a bar", "set": {"SessionFlags": "furled"}},
    {"at": 28, "log": "5/15 meatball: an orange disc", "set": {"SessionFlags": "repair"}},
    {"at": 34, "log": "6/15 chequered: a checkerboard", "set": {"SessionFlags": "checkered"}},
    {"at": 40, "log": "7/15 full-course caution: yellow in bands", "set": {"SessionFlags": "yellow|yellowWaving|caution|cautionWaving"}},
    {"at": 46, "log": "8/15 waved yellow: yellow, blinking", "set": {"SessionFlags": "yellow|yellowWaving"}},
    {"at": 52, "log": "9/15 yellow: solid, steady", "set": {"SessionFlags": "yellow"}},
    {"at": 58, "log": "10/15 debris: yellow with danger stripes", "set": {"SessionFlags": "debris"}},
    {"at": 64, "log": "11/15 blue: an arrow that moves", "set": {"SessionFlags": "blue"}},
    {"at": 70, "log": "12/15 white: the last lap", "set": {"SessionFlags": "white"}},
    {"at": 76, "log": "13/15 green", "set": {"SessionFlags": "green"}},
    {"at": 82, "log": "14/15 set: two bars of the start gantry", "set": {"SessionFlags": "startSet"}},
    {"at": 88, "log": "15/15 ready: one bar", "set": {"SessionFlags": "startReady"}},
    {"at": 94, "log": "flags clear; everything below them can now show", "set": {"SessionFlags": "green"}},
    {"at": 96, "set": {"SessionFlags": 0}},

    // --- The pit family ---------------------------------------------------------------------
    // EngineWarnings 16 is PitSpeedLimiter, which is what SimHub reads for PitLimiterOn.
    {"at": 100, "log": "limiter on, out of the lane: an exclamation mark, blinking", "set": {"EngineWarnings": 16}},
    {"at": 106, "log": "limiter on, in the lane: a two-pixel frame, steady", "set": {"OnPitRoad": 1}},
    {"at": 112, "log": "speeding in the lane: a double chevron in red", "set": {"Speed": 34.0}},
    {"at": 118, "log": "out of the pits", "set": {"EngineWarnings": 0, "OnPitRoad": 0, "Speed": 55.0}},

    // --- The spotter ------------------------------------------------------------------------
    // CarLeftRight: 1 clear, 2 left, 3 right, 4 both.
    {"at": 122, "log": "a car on the left: a bar down the left edge", "set": {"CarLeftRight": 2}},
    {"at": 127, "log": "a car on the right", "set": {"CarLeftRight": 3}},
    {"at": 132, "log": "cars both sides", "set": {"CarLeftRight": 4}},
    {"at": 137, "log": "clear", "set": {"CarLeftRight": 1}},

    // --- The warnings -----------------------------------------------------------------------
    {"at": 140, "log": "oil too hot: a disc, orange, blinking", "set": {"OilTemp": 130.0}},
    {"at": 145, "log": "water too hot: waves", "set": {"OilTemp": 95.0, "WaterTemp": 118.0}},
    {"at": 150, "log": "low fuel: a tank emptying", "set": {"WaterTemp": 88.0, "FuelLevel": 1.2}},

    // --- The gear, which is what comes back when nothing else is out -------------------------
    {"at": 153, "log": "nothing out: the gear, resting colour", "set": {"FuelLevel": 40.0, "Gear": 1, "RPM": 2000.0}},
    {"at": 154, "log": "the gear through the shift bands and the redline", "driver": {"type": "rpmSweep", "enabled": true}},
    {"at": 154, "driver": {"type": "gearFromRpm", "enabled": true}}
  ]
}
