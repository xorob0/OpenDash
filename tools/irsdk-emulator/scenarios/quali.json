{
  // A timed qualifying run in a car with no in-car traction control or ABS: the assist cards show
  // their no-data state, the session card counts time rather than laps, and SimHub names the session
  // "Lone Qualify", so a surface that reads `SessionTypeName` sees a qualifying session.
  //
  // It selects session 1 of race-session.yaml, which is the weekend's qualifying and already fifteen
  // minutes with unlimited laps, rather than dressing up the race as one: SimHub takes
  // GameData.SessionTypeName from the session whose SessionNum matches the telemetry's, so until
  // #307 this scenario was a timed race with a qualifying name and its trace read "Race". The field's
  // standings are routed into that session, and the race after it holds none.
  "extends": "notc.json",
  "name": "Timed qualifying, car without TC or ABS controls",
  "yaml": {
    "TcSetting": "",
    "AbsSetting": "",
    "QualifyResultsPositions": "\n{{ResultsPositions}}",
    "QualifyResultsFastestLap": "\n{{ResultsFastestLap}}",
    "RaceResultsPositions": "",
    "RaceResultsFastestLap": "\n   - CarIdx: 255\n     FastestLap: 0\n     FastestTime: -1.0000"
  },
  "variables": [
    {"name": "SessionNum", "value": 1},
    {"name": "SessionFlags", "value": "green", "pin": true},
    {"name": "SessionTimeTotal", "value": 900.0},
    {"name": "SessionTimeRemain", "value": 412.0},
    {"name": "SessionTime", "value": 488.0},
    {"name": "PlayerCarPosition", "value": 1, "pin": true},
    {"name": "PlayerCarClassPosition", "value": 1, "pin": true},
    {"name": "Lap", "value": 5},
    {"name": "LapCompleted", "value": 4},
    {"name": "RaceLaps", "value": 5},
    {"name": "LapBestLapTime", "value": 96.284},
    {"name": "LapLastLapTime", "value": 96.284},
    {"name": "FuelLevel", "value": 21.7, "pin": true},
    {"name": "FuelLevelPct", "value": 0.217, "pin": true}
  ],
  "timeline": [
    {"at": 0, "log": "hold green through the run", "driver": {"type": "flagCycle", "enabled": false}},
    {"at": 0, "driver": {"type": "fuelBurn", "enabled": false}}
  ]
}
