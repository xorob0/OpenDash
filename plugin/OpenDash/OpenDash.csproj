<Project Sdk="Microsoft.NET.Sdk">
  <!-- SimHub plugin: installs the embedded openDash package and exposes its settings as properties.
       net48, code-only WPF (no UseWPF, no XAML) so that `dotnet build` works on Linux against the
       Microsoft.NETFramework.ReferenceAssemblies package and the SimHub assemblies in ../lib. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenDash</AssemblyName>
    <RootNamespace>OpenDashPlugin</RootNamespace>
    <Description>OpenDash: an open-source SimHub dashboard and the plugin that installs it and exposes its settings.</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Framework assemblies. WPF is referenced directly; there is no XAML to compile. -->
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- DataContractJsonSerializer, for reading the release listing; see ReleaseFeed.cs. -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- SimHub reference assemblies, committed under plugin/lib. Private=false: SimHub ships them. -->
  <ItemGroup>
    <Reference Include="SimHub.Plugins">
      <HintPath>../lib/SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>../lib/SimHub.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>../lib/GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>../lib/log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>../lib/MahApps.Metro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The dashboard packages the plugin installs, one per screen size. The dash build writes build/*.simhubdash and
       CI copies them into Resources/ before building; the folder is gitignored (see Resources/README.md).
       Every resource whose name ends in .simhubdash is installed, so the manifest name does not matter: MSBuild names
       these "OpenDashPlugin.Resources.<file name>" and keeps the spaces of names like "openDash 1280x480.simhubdash";
       the dashboard folder is read from the zip itself (PackageExtractor.PackageFolderName). -->
  <ItemGroup>
    <!-- Except the card faces, which since XOR-118 are the ones named "openDash slots ...". The zone faces
         now carry the shipped names and are what a user gets; the card faces are still built so that the two
         can be compared on a rig before XOR-95 deletes the card path, and they must not be installed beside
         their replacements.

         This exclusion was the other way round until the rename, and it is the line that has to move with it:
         a stale pattern here excludes nothing and the plugin silently embeds every package, which is exactly
         the shape of XOR-123. e2e.test.ts asserts which folders a release embeds, so the two cannot part
         company unnoticed. The exclusion lives here rather than in the copy step because CI copies the whole
         dash artefact in, and a rule that only scripts/package.sh applied would hold locally and not in a
         release. -->
    <EmbeddedResource Include="Resources/*.simhubdash" Exclude="Resources/openDash slots *.simhubdash" />
  </ItemGroup>

  <!-- The flag box profile. Embedded the same way and extracted at runtime (FlagBoxProfile.cs), but
       not installed: ADR 0013 decided the plugin writes the file where the user can find it and never
       into SimHub's own ArduinoRGBMatrixSettings.json, which SimHub rewrites underneath us. Allowed to
       be absent for the same reason the packages are: the plugin loads without it and says so. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/*.ledsprofile" />
  </ItemGroup>

  <!-- The faces the settings panel draws in, extracted to a private folder at runtime (PanelFonts.cs).
       They come from the dash build rather than from fonts/ directly: the condensed ones are renamed on the
       way out of it, because WPF folds a family whose name carries a width word into the unadorned one and
       the panel would otherwise draw in Barlow. The dash build writes them to build/fonts and CI copies
       them into Resources/fonts beside the packages, which is the same route the .simhubdash files take.
       Redistributed under the SIL OFL 1.1 (fonts/OFL.txt). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" LogicalName="OpenDash.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../packages/dash/fonts/OFL.txt" Link="Fonts/OFL.txt" LogicalName="OpenDash.Fonts.OFL.txt" />
  </ItemGroup>

  <!-- A glob that matches nothing embeds nothing, the build still succeeds, and the panel then falls back to
       Segoe UI behind one warning in SimHub's log, which is a release-looking DLL whose panel is quietly
       unstyled. The packages are allowed to be absent, since a plugin without them still loads and says so;
       the fonts are not, because nothing downstream can tell that they were meant to be there. -->
  <Target Name="RequirePanelFonts" BeforeTargets="BeforeBuild">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('Extension', '.ttf'))' == ''"
           Text="No fonts in plugin/OpenDash/Resources/fonts. They are build output of packages/dash: run `bun run build` and `cp -R build/fonts plugin/OpenDash/Resources/fonts`, or use `bun run package`, which does both." />
  </Target>
</Project>
