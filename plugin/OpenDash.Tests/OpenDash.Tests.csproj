<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the plugin's pure logic. The plugin targets net48 and references SimHub's WPF
       assemblies, which cannot run here, so the files that have no SimHub or WPF dependency are compiled
       into this net8.0 project directly. Keep those files free of SimHub and WPF types. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OpenDashPlugin.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../OpenDash/Contract.cs" Link="Plugin/Contract.cs" />
    <Compile Include="../OpenDash/Cards.cs" Link="Plugin/Cards.cs" />
    <Compile Include="../OpenDash/Modules.cs" Link="Plugin/Modules.cs" />
    <Compile Include="../OpenDash/FacePages.cs" Link="Plugin/FacePages.cs" />
    <Compile Include="../OpenDash/FaceSettings.cs" Link="Plugin/FaceSettings.cs" />
    <Compile Include="../OpenDash/ScreenInstance.cs" Link="Plugin/ScreenInstance.cs" />
    <Compile Include="../OpenDash/PackageCatalogue.cs" Link="Plugin/PackageCatalogue.cs" />
    <Compile Include="../OpenDash/OpenDashSettings.cs" Link="Plugin/OpenDashSettings.cs" />
    <Compile Include="../OpenDash/Versioning.cs" Link="Plugin/Versioning.cs" />
    <Compile Include="../OpenDash/Installation.cs" Link="Plugin/Installation.cs" />
    <Compile Include="../OpenDash/PackageExtractor.cs" Link="Plugin/PackageExtractor.cs" />
    <Compile Include="../OpenDash/DashboardInstaller.Core.cs" Link="Plugin/DashboardInstaller.Core.cs" />
    <Compile Include="../OpenDash/Theme.cs" Link="Plugin/Theme.cs" />
    <Compile Include="../OpenDash/Mark.cs" Link="Plugin/Mark.cs" />
    <Compile Include="../OpenDash/ReleaseFeed.cs" Link="Plugin/ReleaseFeed.cs" />
    <Compile Include="../OpenDash/UpdateCheck.cs" Link="Plugin/UpdateCheck.cs" />
    <Compile Include="../OpenDash/UpdateWording.cs" Link="Plugin/UpdateWording.cs" />
    <Compile Include="../OpenDash/ReleaseClient.cs" Link="Plugin/ReleaseClient.cs" />
    <Compile Include="../OpenDash/FolderFingerprint.cs" Link="Plugin/FolderFingerprint.cs" />
    <Compile Include="../OpenDash/UpdatePlan.cs" Link="Plugin/UpdatePlan.cs" />
    <Compile Include="../OpenDash/UpdateService.cs" Link="Plugin/UpdateService.cs" />
    <Compile Include="../OpenDash/FlagBoxProfile.cs" Link="Plugin/FlagBoxProfile.cs" />
    <Compile Include="../OpenDash/FlagBoxInstallPlan.cs" Link="Plugin/FlagBoxInstallPlan.cs" />
  </ItemGroup>

  <!-- A resource whose file name has spaces, embedded by the same MSBuild rule the plugin's Resources/*.simhubdash use;
       DashboardInstallerTests pins the manifest name MSBuild gives it. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/resource name with spaces.txt" />
    <EmbeddedResource Include="Fixtures/github-releases.json" />
    <!-- Under Resources/ and named with a space on purpose: both are what the plugin ships, and
         FlagBoxProfile.FileNameOf reads the name back out of the manifest name MSBuild gives it.

         The strip beside it is the pin on FlagBoxProfile.ResourceName and is embedded for no other
         reason. A release carries nineteen RPM strips next to the one matrix profile, they all end
         in .ledsprofile, and "openDash 0-10-0" sorts ahead of "openDash Flag box" because '0' is
         0x30 and 'F' is 0x46, so an extractor that takes the first resource in sort order takes a
         ten-LED RPM strip and hands it to SimHub's MATRIX driver. Keep a decoy here that sorts
         first, or the tests below pass on the order of the list rather than on the selection. -->
    <EmbeddedResource Include="Resources/openDash Flag box.ledsprofile" />
    <EmbeddedResource Include="Resources/openDash 0-10-0.ledsprofile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
