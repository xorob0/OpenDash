{
  "$meta": {
    "name": "openDash design tokens",
    "version": "0.1.0",
    "license": "MIT",
    "note": "Single source of truth. Feeds (a) the CSS used for design renders, (b) the .djson generator, (c) Figma variables. Never hand-edit colours downstream."
  },

  "color": {
    "bg": {
      "base":     { "value": "#0A0B0D", "desc": "Dash background. Near-black, not pure black — pure black blooms on OLED/IPS DDUs." },
      "surface":  { "value": "#14161A", "desc": "Zone fill" },
      "raised":   { "value": "#1C1F24", "desc": "Raised block / separator rule" },
      "inset":    { "value": "#060708", "desc": "Recessed well behind gauges" }
    },
    "text": {
      "primary":   { "value": "#F5F7FA", "desc": "Primary numerals" },
      "secondary": { "value": "#8A9099", "desc": "Supporting values" },
      "label":     { "value": "#5A6069", "desc": "Uppercase field labels" },
      "dim":       { "value": "#33383F", "desc": "Inactive / placeholder segments" }
    },
    "brand": {
      "cyan": { "value": "#33D9F2", "desc": "openDash identity ONLY — logo, plugin panel, docs. NEVER appears on the dash face, so it can never be misread as a state." }
    },
    "state": {
      "good":    { "value": "#00D96A", "desc": "Shift stage 1, delta faster, within limits" },
      "caution": { "value": "#FFB300", "desc": "Shift stage 2, caution, yellow-adjacent warnings" },
      "danger":  { "value": "#FF2D46", "desc": "Shift stage 3, delta slower, alarms" },
      "info":    { "value": "#2E7BFF", "desc": "Blue flag" },
      "best":    { "value": "#B14BFF", "desc": "Session best — sim-racing purple convention" },
      "neutral": { "value": "#FFFFFF", "desc": "White flag, pit limiter" }
    },
    "flag": {
      "yellow": { "value": "#FFD400" },
      "blue":   { "value": "#2E7BFF" },
      "white":  { "value": "#FFFFFF" },
      "black":  { "value": "#F5F7FA" },
      "green":  { "value": "#00D96A" },
      "chequer":{ "value": "#F5F7FA" }
    }
  },

  "font": {
    "family": {
      "data":  { "value": "Barlow Condensed", "license": "SIL OFL 1.1", "desc": "All numerals. DIN-adjacent condensed grotesque." },
      "label": { "value": "Barlow",           "license": "SIL OFL 1.1", "desc": "Uppercase labels and plugin UI." }
    },
    "size": {
      "gear":     { "value": 260 },
      "hero":     { "value": 116, "desc": "Speed, delta" },
      "lapTime":  { "value": 64 },
      "value":    { "value": 46 },
      "valueSm":  { "value": 34 },
      "label":    { "value": 15 },
      "labelSm":  { "value": 13 }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "tracking": {
      "label":   { "value": "0.14em" },
      "numeral": { "value": "-0.01em" }
    }
  },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },

  "radius": {
    "none": { "value": 0, "desc": "Default. Race dashes are hard-edged." },
    "sm":   { "value": 2 },
    "seg":  { "value": 2, "desc": "Shift-light segment" }
  },

  "shiftLights": {
    "segments": { "value": 15 },
    "stages": [
      { "from": 0.00, "to": 0.33, "color": "state.good" },
      { "from": 0.33, "to": 0.66, "color": "state.caution" },
      { "from": 0.66, "to": 1.00, "color": "state.danger" }
    ],
    "flashAtRedline": { "value": true },
    "flashHz": { "value": 8 }
  },

  "screen": {
    "mvp":    { "w": 1920, "h": 480, "desc": "MVP target. 8.8in ultrawide DDU." },
    "future": [
      { "w": 1280, "h": 480, "desc": "10in — same height as MVP, pure reflow" },
      { "w": 1280, "h": 400, "desc": "7.8in" },
      { "w": 850,  "h": 480, "desc": "5in" }
    ]
  }
}
